# Global Root Environment Variables Example
PORT=3000
NODE_ENV=development

# Database Connection
POSTGRES_USER=talentsync_admin
POSTGRES_PASSWORD=secure_postgres_pass_2026
POSTGRES_DB=talentsync_db
DATABASE_URL=postgresql://talentsync_admin:secure_postgres_pass_2026@localhost:5432/talentsync_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_pass_2026
REDIS_URL=redis://:secure_redis_pass_2026@localhost:6379

# Kafka Event Bus
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=talentsync-cluster

# Security & Auth Tokens
JWT_SECRET=super_secret_jwt_access_key_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Mailer Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=notifications@talentsync.ai
